{
  "name": "inventory-pwa",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "analyze": "vite build && source-map-explorer dist/assets/*.js",
    "perf": "vite build && vite preview --port 4173 & sleep 3 && node perf-test.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "install-functions": "cd netlify/functions/neon-proxy && npm install",
    "lint": "eslint src",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && wrangler dev"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-modal": "^3.16.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.33.2",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.15",
    "daisyui": "^3.2.2",
    "eslint": "^9.39.1",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.4.0",
    "vite": "^7.2.6",
    "vite-plugin-css-injected-by-js": "^2.1.1",
    "vite-plugin-html": "^3.2.2",
    "wrangler": "^4.85.0"
  }
}
